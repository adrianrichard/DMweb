# Copiá este archivo como ".env" (con el punto adelante, sin guion bajo)
# y completá los valores reales. NO subas el .env real a git.
#
# IMPORTANTE: una variable por línea. No pongas varias en la misma línea.

SECRET_KEY=reemplazar-con-el-resultado-de-secrets.token_hex
DB_USER=dentalmatic
DB_PASSWORD=reemplazar-con-tu-clave-de-postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dentalmatic
